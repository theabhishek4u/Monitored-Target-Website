# Database URL: SQLite (default) or PostgreSQL (Supabase)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL="file:./dev.db"

# Application Timezone for date slicing (Today, Yesterday, 7D, 30D)
APP_TIMEZONE="Asia/Kolkata"

PORT=3000
